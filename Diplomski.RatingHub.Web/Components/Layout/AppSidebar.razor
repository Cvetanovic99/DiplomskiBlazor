@using Diplomski.RatingHub.Domain.Constants
@inherits Diplomski.RatingHub.Web.Components.Shared.PortalComponentBase
<AuthorizeView>
    <Authorized Context="authContext">
        <aside class="app-sidebar @(IsExpanded ? "expanded" : "collapsed") d-none d-md-flex">
            <nav class="app-sidebar-nav">
                <AuthorizeView Roles="@Roles.RegularUser">
                    <Authorized Context="userContext">
                        <a href="/user/profile" class="app-sidebar-link" title="Profil">
                            <RadzenIcon Icon="account_circle" class="app-sidebar-link-icon"/>
                            <span class="app-sidebar-link-text">Profil</span>
                        </a>
                        
                        <button @onclick="NotificationsClicked" class="app-sidebar-link app-sidebar-link-notifications" title="Obavestenja">
                            @if (_unreadNotifications)
                            {
                                <RadzenIcon Icon="notifications_unread" class="app-sidebar-link-icon unread-notifications-icon"/>
                            }
                            else
                            {
                                <RadzenIcon Icon="notifications" class="app-sidebar-link-icon notification-icon"/>
                            }
                            <span class="app-sidebar-link-text">Obaveštenja</span>
                        </button>

                        <a href="/user/companies" class="app-sidebar-link" title="Moje kompanije">
                            <RadzenIcon Icon="domain" class="app-sidebar-link-icon"/>
                            <span class="app-sidebar-link-text">Moje kompanije</span>
                        </a>
                        
                        <a href="/user/reviews" class="app-sidebar-link" title="Moja ocenjivanja">
                            <RadzenIcon Icon="reviews" class="app-sidebar-link-icon"/>
                            <span class="app-sidebar-link-text">Moja ocenjivanja</span>
                        </a>
                        
                        <a href="/" class="app-sidebar-link" title="Pocetna">
                            <RadzenIcon Icon="home" class="app-sidebar-link-icon"/>
                            <span class="app-sidebar-link-text">Početna stranica</span>
                        </a>
                        
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="@Roles.Administrator">
                    <Authorized Context="adminContext">
                        <a href="/categories" class="app-sidebar-link" title="Kategorije">
                            <RadzenIcon Icon="category" class="app-sidebar-link-icon"/>
                            <span class="app-sidebar-link-text">Kategorije</span>
                        </a>
                        
                        <a href="/reportedContent" class="app-sidebar-link" title="Prijavljene objave">
                            <RadzenIcon Icon="report" class="app-sidebar-link-icon"/>
                            <span class="app-sidebar-link-text">Prijavljene objave</span>
                        </a>
                        
                        <a href="/companyVerificationRequests" class="app-sidebar-link" title="Zahtevi za verifikaciju">
                            <RadzenIcon Icon="verified_user" class="app-sidebar-link-icon"/>
                            <span class="app-sidebar-link-text">Verifikacioni zahtevi</span>
                        </a>
                    </Authorized>
                </AuthorizeView>

                <form action="Account/Logout" method="post">
                    <AntiforgeryToken/>
                    <button type="submit" class="app-sidebar-link app-sidebar-link-danger">
                        <RadzenIcon Icon="logout" class="app-sidebar-link-icon"/>
                        <span class="app-sidebar-link-text">Odjavi se</span>
                    </button>
                </form>

            </nav>
        </aside>
    </Authorized>
</AuthorizeView>