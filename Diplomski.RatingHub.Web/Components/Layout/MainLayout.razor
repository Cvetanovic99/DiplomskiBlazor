@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider

<RadzenComponents />

<div class="app-layout @(GetSidebarLayoutClass())">
    <AppHeader OnToggleDesktopSidebar="ToggleDesktopSidebar" />
    <AppSidebar IsExpanded="sidebarExpanded" />
    <AppOffcanvasMenu />

    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool sidebarExpanded;
    private bool isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await LoadAuthStateAsync();
    }

    private async Task LoadAuthStateAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        StateHasChanged();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (!isAuthenticated)
        {
            sidebarExpanded = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ToggleDesktopSidebar()
    {
        if (!isAuthenticated)
            return;

        sidebarExpanded = !sidebarExpanded;
    }

    private string GetSidebarLayoutClass()
    {
        if (!isAuthenticated)
            return "sidebar-hidden";

        return sidebarExpanded ? "sidebar-expanded" : "sidebar-collapsed";
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}