<div class="offcanvas offcanvas-end app-mobile-offcanvas"
     tabindex="-1"
     id="appMobileOffcanvas"
     aria-labelledby="appMobileOffcanvasLabel">
    <div class="offcanvas-header app-mobile-offcanvas-header">
        <div class="app-mobile-offcanvas-brand">
            <img src="/images/Logo-square.png" alt="Logo" class="app-mobile-offcanvas-logo" />
            <div>
                <div id="appMobileOffcanvasLabel" class="app-mobile-offcanvas-title">Kriterijum</div>
                <div class="app-mobile-offcanvas-subtitle">Evaluacija pružalaca usluga</div>
            </div>
        </div>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"
                aria-label="Zatvori">
        </button>
    </div>

    <div class="offcanvas-body app-mobile-offcanvas-body">
        <nav class="app-mobile-nav">
            <a href="/" class="app-mobile-link">
                <RadzenIcon Icon="home" class="app-mobile-link-icon" />
                <span>Početna</span>
            </a>

            <a href="/categories" class="app-mobile-link">
                <RadzenIcon Icon="category" class="app-mobile-link-icon" />
                <span>Kategorije</span>
            </a>

            <a href="/#home-search-section" class="app-mobile-link">
                <RadzenIcon Icon="search" class="app-mobile-link-icon" />
                <span>Pretraga</span>
            </a>

            <AuthorizeView>
                <Authorized Context="authState">
                    <div class="app-mobile-userbox">
                        <div class="app-mobile-userlabel">Ulogovani korisnik</div>
                        <div class="app-mobile-username">@GetDisplayName(authState.User)</div>
                    </div>

                    <a href="/dashboard" class="app-mobile-link">
                        <RadzenIcon Icon="dashboard" class="app-mobile-link-icon" />
                        <span>Kontrolna tabla</span>
                    </a>

                    <a href="/my-reviews" class="app-mobile-link">
                        <RadzenIcon Icon="reviews" class="app-mobile-link-icon" />
                        <span>Moje ocene</span>
                    </a>

                    <a href="/my-companies" class="app-mobile-link">
                        <RadzenIcon Icon="business" class="app-mobile-link-icon" />
                        <span>Moje firme</span>
                    </a>

                    <a href="/companies/create" class="app-mobile-link">
                        <RadzenIcon Icon="add_business" class="app-mobile-link-icon" />
                        <span>Dodaj firmu</span>
                    </a>

                    <a href="/profile" class="app-mobile-link">
                        <RadzenIcon Icon="person" class="app-mobile-link-icon" />
                        <span>Profil</span>
                    </a>

                    <a href="/Account/Logout" class="app-mobile-link app-mobile-link-danger">
                        <RadzenIcon Icon="logout" class="app-mobile-link-icon" />
                        <span>Odjavi se</span>
                    </a>
                </Authorized>

                <NotAuthorized>
                    <div class="app-mobile-divider"></div>

                    <a href="/Account/Login" class="app-mobile-link">
                        <RadzenIcon Icon="login" class="app-mobile-link-icon" />
                        <span>Prijavi se</span>
                    </a>

                    <a href="/Account/Register" class="app-mobile-link">
                        <RadzenIcon Icon="person_add" class="app-mobile-link-icon" />
                        <span>Kreiraj nalog</span>
                    </a>

                    <a href="/companies/create" class="app-mobile-link">
                        <RadzenIcon Icon="business_center" class="app-mobile-link-icon" />
                        <span>Dodaj firmu za ocenjivanje</span>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</div>