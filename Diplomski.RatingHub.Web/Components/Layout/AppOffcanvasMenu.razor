@using Diplomski.RatingHub.Domain.Constants
<div class="offcanvas offcanvas-end app-mobile-offcanvas"
     tabindex="-1"
     id="appMobileOffcanvas"
     aria-labelledby="appMobileOffcanvasLabel">
    <div class="offcanvas-header app-mobile-offcanvas-header">
        <div class="app-mobile-offcanvas-brand">
            <img src="/images/Logo-square.png" alt="Logo" class="app-mobile-offcanvas-logo" />
            <div>
                <div id="appMobileOffcanvasLabel" class="app-mobile-offcanvas-title">Kriterijum</div>
                <div class="app-mobile-offcanvas-subtitle">Evaluacija pružalaca usluga</div>
            </div>
        </div>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"
                aria-label="Zatvori">
        </button>
    </div>

    <div class="offcanvas-body app-mobile-offcanvas-body">
        <nav class="app-mobile-nav">
            
            <AuthorizeView>
                <Authorized Context="authContext">

                    <AuthorizeView Roles="@Roles.RegularUser">
                        <Authorized Context="userContext">

                            <div class="app-mobile-userbox">
                                <div class="app-mobile-userlabel">Ulogovani korisnik</div>
                                <div class="app-mobile-username">@GetDisplayName(userContext.User)</div>
                            </div>

                            <a href="/user/profile" class="app-mobile-link">
                                <RadzenIcon Icon="account_circle" class="app-mobile-link-icon"/>
                                <span>Profil</span>
                            </a>

                            <a href="/user/notifications" class="app-mobile-link">
                                <RadzenIcon Icon="notifications" class="app-mobile-link-icon"/>
                                <span>Obaveštenja</span>
                            </a>

                            <a href="/user/companies" class="app-mobile-link">
                                <RadzenIcon Icon="domain" class="app-mobile-link-icon"/>
                                <span>Moje kompanije</span>
                            </a>

                            <a href="/user/reviews" class="app-mobile-link">
                                <RadzenIcon Icon="reviews" class="app-mobile-link-icon"/>
                                <span>Moja ocenjivanja</span>
                            </a>

                            <a href="/" class="app-mobile-link">
                                <RadzenIcon Icon="home" class="app-mobile-link-icon"/>
                                <span>Početna stranica</span>
                            </a>
                        </Authorized>
                    </AuthorizeView>

                    <AuthorizeView Roles="@Roles.Administrator">
                        <Authorized Context="adminContext">

                            <a href="/categories" class="app-mobile-link">
                                <RadzenIcon Icon="category" class="app-mobile-link-icon"/>
                                <span>Kategorije</span>
                            </a>

                            <a href="/reportedContent" class="app-mobile-link">
                                <RadzenIcon Icon="report" class="app-mobile-link-icon"/>
                                <span>Prijavljene objave</span>
                            </a>

                            <a href="/companyVerificationRequests" class="app-mobile-link">
                                <RadzenIcon Icon="verified_user" class="app-mobile-link-icon"/>
                                <span>Verifikacioni zahtevi</span>
                            </a>
                        </Authorized>
                    </AuthorizeView>

                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken/>
                        <button type="submit" class="app-mobile-link app-mobile-link-danger">
                            <RadzenIcon Icon="logout" class="app-mobile-link-icon"/>
                            <span>Odjavi se</span>
                        </button>
                    </form>
                </Authorized>

                <NotAuthorized>
                    <a href="/Account/Login" class="app-mobile-link">
                        <RadzenIcon Icon="login" class="app-mobile-link-icon"/>
                        <span>Prijavi se</span>
                    </a>

                    <a href="/Account/Register" class="app-mobile-link">
                        <RadzenIcon Icon="person_add" class="app-mobile-link-icon"/>
                        <span>Kreiraj nalog</span>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</div>