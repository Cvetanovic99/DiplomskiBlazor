@using Radzen

<footer class="app-footer">
    <div class="app-footer-shell">
        <div class="app-footer-top">
            <div class="app-footer-brand">
                <div class="app-footer-logo-wrap">
                    <img src="/images/Logo-square.png" alt="Kriterijum logo" class="app-footer-logo" />
                </div>

                <div class="app-footer-brand-content">
                    <h3 class="app-footer-title">Kriterijum</h3>
                    <p class="app-footer-description">
                        Kriterijum je platforma za evaluaciju i rangiranje pruzalaca usluga, 
                        namenjena laksem pronalazenju kvalitetnih firmi, majstora i strucnjaka na osnovu ocena, 
                        iskustava korisnika i relevantnih informacija.
                    </p>
                </div>
            </div>

            <div class="app-footer-columns">
                <div class="app-footer-column">
                    <h4 class="app-footer-heading">Kontakt</h4>

                    <a href="mailto:kontakt@kriterijum.rs" class="app-footer-link">
                        <RadzenIcon Icon="mail" class="app-footer-link-icon" />
                        <span>kontakt@kriterijum.rs</span>
                    </a>

                    <a href="tel:+381601234567" class="app-footer-link">
                        <RadzenIcon Icon="call" class="app-footer-link-icon" />
                        <span>+381 60 123 4567</span>
                    </a>

                    <a href="https://wa.me/381601234567" class="app-footer-link" target="_blank" rel="noopener noreferrer">
                        <RadzenIcon Icon="chat" class="app-footer-link-icon" />
                        <span>WhatsApp kontakt</span>
                    </a>
                </div>

                <div class="app-footer-column">
                    <h4 class="app-footer-heading">Drustvene mreze</h4>

                    <a href="https://instagram.com" class="app-footer-link" target="_blank" rel="noopener noreferrer">
                        <RadzenIcon Icon="photo_camera" class="app-footer-link-icon" />
                        <span>Instagram</span>
                    </a>

                    <a href="https://facebook.com" class="app-footer-link" target="_blank" rel="noopener noreferrer">
                        <RadzenIcon Icon="thumb_up" class="app-footer-link-icon" />
                        <span>Facebook</span>
                    </a>
                </div>

                <div class="app-footer-column">
                    <h4 class="app-footer-heading">Pravne informacije</h4>

                    <a href="/privacy-policy" class="app-footer-link">
                        <RadzenIcon Icon="shield" class="app-footer-link-icon" />
                        <span>Politika privatnosti</span>
                    </a>

                    <a href="/terms-of-use" class="app-footer-link">
                        <RadzenIcon Icon="description" class="app-footer-link-icon" />
                        <span>Uslovi koriscenja</span>
                    </a>

                    <a href="/cookie-policy" class="app-footer-link">
                        <RadzenIcon Icon="cookie" class="app-footer-link-icon" />
                        <span>Politika kolacica</span>
                    </a>

                    <a href="/impressum" class="app-footer-link">
                        <RadzenIcon Icon="gavel" class="app-footer-link-icon" />
                        <span>Impressum / Kontakt podaci</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="app-footer-bottom">
            <span class="app-footer-copy">
                © @CurrentYear Kriterijum. Studentski projekat - svi podaci i linkovi su demonstracioni.
            </span>
        </div>
    </div>
</footer>