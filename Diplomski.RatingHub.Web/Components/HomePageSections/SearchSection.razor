@inherits Diplomski.RatingHub.Web.Components.Shared.PortalComponentBase

<section class="search-section" id="@SectionId">
    <div class="search-shell">
        <div class="search-card">
            <div class="search-header">
                <div class="search-badge">
                    <RadzenIcon Icon="travel_explore" class="search-badge-icon" />
                    <span>Brza pretraga</span>
                </div>

                <h2 class="search-title">Pretražite usluge, firme i gradove</h2>
                <p class="search-subtitle">
                    Prvo izaberite najbliži grad vama, zatim unesite kategoriju, naziv pružaoca usluge ili PIB kompanije i pretražite rezultate.
                </p>
            </div>

            <div class="search-form">
                <div class="search-inputs">

                    <div class="search-field">
                        <label class="search-label search-label-with-icon" for="search-city">
                            <span>Grad</span>
                            <RadzenIcon Icon="add_location_alt" class="search-label-icon" />
                        </label>
                        
                        <RadzenAutoComplete
                            Name="City"
                            Data="@_cities"
                            TextProperty="Name"
                            @bind-Value="_selectedCityText"
                            MinLength="1"
                            LoadData="@LoadCities"
                            Change="@OnCityChanged"
                            SelectedItemChanged="@OnCitySelected"
                            SelectedItem="@_selectedCityText"
                            Style="width:100%"
                            Placeholder="Npr. Niš, Beograd, Novi Sad..." 
                            class="search-autocomplete"/>
                    </div>
                    
                    <div class="search-field">
                        <label class="search-label search-label-with-icon" for="search-term">
                            <span>Šta tražite</span>
                            <RadzenIcon Icon="psychology_alt" class="search-label-icon" />
                        </label>
                        
                        <RadzenAutoComplete
                            Name="Category"
                            @bind-Value="_selectedCategoryText"
                            TextProperty="Name"
                            Data="@_categoriesAndCompanies"
                            MinLength="1"
                            LoadData="@LoadCategoriesAndCompanies"
                            Change="@OnCategoryChanged"
                            SelectedItem="_selectedCategoryText"
                            SelectedItemChanged="@OnCategorySelected"
                            Disabled="@(_selectedCityId == 0)"
                            Style="width:100%"
                            Placeholder="Npr. frizer, vodoinstalater, PIB kompanije..."
                            class="search-autocomplete">

                            <Template Context="c">
                                @if (c.IsCategory)
                                {
                                    <div class="category-item">
                                        <div class="category-name">@c.Name</div>
                                        <div class="category-path">@c.FullPath</div>
                                    </div>
                                }
                                else
                                {
                                     <div class=@(!c.IsSponsored ? "company-item" : "company-item-sponsored")>

                                            <img src="@(string.IsNullOrEmpty(c.ProfileImagePath)
                                                          ? "/images/companyImages/genericCompanyImage.svg"
                                                          : c.ProfileImagePath)"
                                                 class="company-img" />

                                            <div class="company-info">

                                                <!-- NAZIV -->
                                                <div class="company-name-row">
                                                    <span class="label">Naziv:</span>
                                                    <span class="company-name">@c.Name</span>
                                                </div>

                                                <!-- META -->
                                                <div class="company-meta">

                                                    <!-- PREUZETA -->
                                                    <div class="meta-item">
                                                        <span class="label">Preuzeta:</span>

                                                        @if (c.HasOwner)
                                                        {
                                                            <RadzenIcon Icon="check_circle" IconStyle="IconStyle.Success" class="icon-success" />
                                                        }
                                                        else
                                                        {
                                                            <RadzenIcon Icon="cancel" IconStyle="IconStyle.Danger" class="icon-danger" />
                                                        }
                                                    </div>

                                                    <!-- PIB -->
                                                    <div class="meta-item">
                                                        <span class="label">PIB:</span>

                                                        @if (!string.IsNullOrWhiteSpace(c.CompanyPib))
                                                        {
                                                            <span class="pib-value">@c.CompanyPib</span>
                                                        }
                                                        else
                                                        {
                                                            <RadzenIcon Icon="cancel" IconStyle="IconStyle.Danger" class="icon-danger" />
                                                        }
                                                    </div>

                                                </div>

                                            </div>

                                        </div>
                                }
                            </Template>

                        </RadzenAutoComplete>
                    </div>
                </div>

                <div class="search-actions">
                    <button type="button" class="search-btn" @onclick="ExecuteSearch">
                        <RadzenIcon Icon="search" class="search-btn-icon" />
                        <span>Pretraži</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>