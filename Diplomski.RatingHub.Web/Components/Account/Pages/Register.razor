@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using Diplomski.RatingHub.Application.Interfaces.Notifications
@using Diplomski.RatingHub.Infrastructure.Auth.Enums
@using Diplomski.RatingHub.Web.CustomValidationAttributes
@using Diplomski.RatingHub.Web.Data.Interfaces
@using Diplomski.RatingHub.Web.Models
@using Microsoft.AspNetCore.Identity


@inject IdentityRedirectManager RedirectManager
@inject IAccountDataService AccountDataService
@inject IEmailNotificationService NotificationService

<PageTitle>Register</PageTitle>

<div class="auth-layout">

    <!-- LEFT SIDE -->
    <div class="auth-left">
        <div class="auth-left-overlay"></div>

        <div class="auth-left-content">
            <div class="auth-brand">
                <img src="/images/Logo-square.png" alt="RatingHub logo" class="auth-logo" />
                <span class="auth-brand-name">Kriterijum</span>
            </div>

            <div class="auth-left-text">
                <h1>Pronađite i ocenite najbolje usluge</h1>
                <p>
                    Platforma koja vam omogućava da na jednom mestu pregledate ocene,
                    komentare i preporuke korisnika za različite pružaoce usluga.
                </p>
            </div>

            <div class="auth-left-points">
                <div class="auth-point">
                    <span class="auth-point-icon">✔</span>
                    <span>Provereni korisnici i pouzdane preporuke</span>
                </div>
                <div class="auth-point">
                    <span class="auth-point-icon">✔</span>
                    <span>Jednostavna pretraga i poređenje usluga</span>
                </div>
                <div class="auth-point">
                    <span class="auth-point-icon">✔</span>
                    <span>Transparentne ocene i komentari</span>
                </div>
            </div>
        </div>
    </div>
    
    <!-- RIGHT SIDE -->
    <div class="auth-right">

        <div class="auth-card">

            <div class="auth-header">
                <h2>Kreirajte nalog</h2>
                <p>Unesite podatke kako biste napravili novi nalog.</p>
            </div>

            <StatusMessage Message="@Message" Type="danger"/>

            <EditForm Model="UserModel"
                      asp-route-returnUrl="@ReturnUrl"
                      method="post"
                      OnValidSubmit="RegisterUser"
                      FormName="register"
                      id="registerForm">

                <DataAnnotationsValidator/>

                <div class="form-group">
                    <label for="register-name">Ime</label>
                    <InputText @bind-Value="UserModel.Name"
                               id="register-name"
                               class="form-control modern-input" />
                    <ValidationMessage For="() => UserModel.Name" class="validation-error" />
                </div>

                <div class="form-group">
                    <label for="register-surname">Prezime</label>
                    <InputText @bind-Value="UserModel.Surname"
                               id="register-surname"
                               class="form-control modern-input" />
                    <ValidationMessage For="() => UserModel.Surname" class="validation-error" />
                </div>

                <div class="form-group">
                    <label for="register-verifier">Email ili telefon</label>
                    <InputText @bind-Value="UserModel.Verifier"
                               id="register-verifier"
                               class="form-control modern-input"
                               autocomplete="username"
                               placeholder="email@gmail.com ili 06xxxxxxxx" />
                    <ValidationMessage For="() => UserModel.Verifier" class="validation-error" />
                </div>

                <div class="form-group">
                    <label for="register-password">Šifra</label>
                    <InputText type="password"
                               @bind-Value="UserModel.Password"
                               id="register-password"
                               class="form-control modern-input"
                               autocomplete="new-password" />
                    <ValidationMessage For="() => UserModel.Password" class="validation-error" />
                </div>

                <div class="form-group">
                    <label for="register-confirm-password">Potvrdite šifru</label>
                    <InputText type="password"
                               @bind-Value="UserModel.ConfirmPassword"
                               id="register-confirm-password"
                               class="form-control modern-input"
                               autocomplete="new-password" />
                    <ValidationMessage For="() => UserModel.ConfirmPassword" class="validation-error" />
                </div>
                
                <button type="submit" class="auth-btn" id="auth-btn">

                    <span id="btnText">
                        Kreiraj nalog
                    </span>

                    <span id="btnSpinner"
                          class="spinner-border spinner-border-sm ms-2"
                          role="status"
                          aria-hidden="true"
                          style="display:none">
                    </span>
                </button>

            </EditForm>

            <div class="auth-footer">
                <a href="/" class="back-home-link">
                    ← Povratak na početnu stranicu
                </a>
            </div>

        </div>

    </div>

</div>

<script>
    
    document.addEventListener("DOMContentLoaded", function () {
    
        const form = document.getElementById("registerForm");
        const button = document.getElementById("auth-btn");
        const spinner = document.getElementById("btnSpinner");
        const text = document.getElementById("btnText");
    
        if (!form) return;
    
        form.addEventListener("submit", function () {
    
            button.disabled = true;
            button.classList.add("submitting");
    
            if (spinner)
                spinner.style.display = "inline-block";
    
            if (text)
                text.textContent = "Kreiranje naloga...";
    
        });
    
    });

</script>

@code {
    private IEnumerable<IdentityError>? identityErrors;

    [SupplyParameterFromForm] private RegisterUserModel UserModel { get; set; } = new();

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string? Message { get; set; }

    public async Task RegisterUser(EditContext editContext)
    {
        RegisterUserResult? result = null;
        try
        {
            result = await AccountDataService.RegisterUser(new RegisterUserDto
            {
                Name = UserModel.Name,
                Surname = UserModel.Surname,
                Verifier = UserModel.Verifier,
                Password = UserModel.Password
            });
            
        }
        catch (Exception e)
        {
            Message = e.Message;
            return;
        }

        if (result != null)
        {
            if(result.RegistrationMethod == RegistrationMethod.Email)
                RedirectManager.RedirectTo(
                    "Account/RegisterConfirmation",
                    new() { ["email"] = result.Verifier });
            else
            {
                RedirectManager.RedirectTo(
                    "Account/ConfirmPhoneNumber",
                    new() { ["identityUserId"] = result.UserIdentityId });
            }
        }
    }
    

    public class RegisterUserModel
    {
        [Required(ErrorMessage = "Unesite ime")]
        [MinLength(1, ErrorMessage = "Name cannot be empty")]
        [Display(Name = "Name")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Unesite prezime")]
        [MinLength(1, ErrorMessage = "Surname cannot be empty")]
        [Display(Name = "Surname")]
        public string Surname { get; set; } = "";
        
        [Required(ErrorMessage="Unesite email ili broj telefona")]
        [EmailOrPhone]
        [Display(Name = "Email or Phone")]
        public string Verifier { get; set; } = "";

        [Required(ErrorMessage = "Unesite sifru")]
        [RegularExpression(@"^(?=.*\d).{8,15}$",
            ErrorMessage = "Sifra se mora sastojati od 8-15 karaktera i mora sadrzati bar jedan broj")]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "Sifre se ne poklapaju")]
        public string ConfirmPassword { get; set; } = "";
    }
}