@page "/Account/RegisterConfirmation"

<PageTitle>Register confirmation</PageTitle>

<div class="confirmation-wrapper">
    <div class="confirmation-card">

        <div class="confirmation-header">
            <div class="confirmation-logo-wrap">
                <img src="/images/Logo-square.png" alt="Logo" class="confirmation-logo" />
            </div>

            <h1>Potvrda registracije</h1>
            <p>
                Hvala na registraciji
            </p>
        </div>

        <div class="confirmation-message-box">
            <div class="confirmation-message-icon">✉</div>

            <div class="confirmation-message-content">
                <div class="confirmation-message-title">
                    Proverite vaše pristigle poruke
                </div>

                <div class="confirmation-message-text">
                    Poslali smo link za potvrdu email adrese na:
                </div>

                <div class="confirmation-email">
                    @Email
                </div>

                <div class="confirmation-message-text confirmation-message-text-bottom">
                    Molimo vas da proverite inbox, kao i spam folder ukoliko poruka nije odmah vidljiva.
                </div>
            </div>
        </div>

        <div class="confirmation-actions">
            <a href="/Account/ResendEmailConfirmation" class="confirmation-primary-link">
                Pošalji ponovo link za potvrdu
            </a>

            <a href="/" class="confirmation-secondary-link">
                ← Povratak na početnu stranicu
            </a>
        </div>

    </div>
</div>

@code {
    [SupplyParameterFromQuery] private string? Email { get; set; }
}