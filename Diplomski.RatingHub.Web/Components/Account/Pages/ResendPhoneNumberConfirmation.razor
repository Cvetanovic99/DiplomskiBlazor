@page "/Account/ResendPhoneNumberConfirmation"
@using System.ComponentModel.DataAnnotations
@using Diplomski.RatingHub.Web.Data.Interfaces

@inject IAccountDataService AccountDataService
@inject IdentityRedirectManager RedirectManager

<div class="resend-wrapper">
    <div class="resend-card">

        <div class="resend-header">
            <div class="resend-logo-wrap">
                <img src="/images/logo.png" alt="Logo" class="resend-logo" />
            </div>

            <h1>Ponovno slanje aktivacionog koda</h1>
            <p>
                Unesite broj telefona kako bismo vam ponovo poslali kod za potvrdu naloga.
            </p>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="resend-status-box error">
                <div class="resend-status-icon">⚠</div>
                <div class="resend-status-content">
                    <div class="resend-status-title">Greška</div>
                    <div class="resend-status-text">@errorMessage</div>
                </div>
            </div>
        }

        <EditForm Model="Input"
                  FormName="resend-phone-confirmation"
                  OnValidSubmit="OnValidSubmitAsync"
                  method="post"
                  id="resendPhoneForm">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="resend-phone">Broj telefona</label>
                <InputText @bind-Value="Input.PhoneNumber"
                           id="resend-phone"
                           class="form-control modern-input"
                           aria-required="true"
                           placeholder="0651234567" />
                <ValidationMessage For="() => Input.PhoneNumber" class="validation-error" />
            </div>

            <button type="submit" class="resend-btn" id="resendPhoneButton">
                <span id="btnText">Pošalji kod za potvrdu</span>
                <span id="btnSpinner"
                      class="spinner-border spinner-border-sm ms-2"
                      role="status"
                      aria-hidden="true"
                      style="display:none">
                </span>
            </button>
        </EditForm>

        <div class="resend-footer">
            <a href="/" class="resend-secondary-link">← Povratak na početnu stranicu</a>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const form = document.getElementById("resendPhoneForm");
        const button = document.getElementById("resendPhoneButton");
        const spinner = document.getElementById("btnSpinner");
        const text = document.getElementById("btnText");

        if (!form) return;

        form.addEventListener("submit", function () {
            button.disabled = true;
            button.classList.add("submitting");

            if (spinner)
                spinner.style.display = "inline-block";

            if (text)
                text.textContent = "Slanje...";
        });

    });
</script>

@code {
    private string? errorMessage;
    
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();

    private async Task OnValidSubmitAsync()
    {
        try
        {
            string identityId = await AccountDataService.ResendPhoneNumberConfirmationToken(Input.PhoneNumber);
            
            RedirectManager.RedirectTo(
                "Account/ConfirmPhoneNumber",
                new() { ["identityUserId"] = identityId });
        }
        catch (Exception e)
        {
            errorMessage = e.Message;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Unesite broj telefona")]
        [RegularExpression(@"^06[0-9]{7,8}$", ErrorMessage = "Unesite validan broj telefona")]
        public string PhoneNumber { get; set; } = "";
    }
}