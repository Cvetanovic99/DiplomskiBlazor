@page "/Account/ResendEmailConfirmation"

@using System.ComponentModel.DataAnnotations
@using Diplomski.RatingHub.Web.Data.Interfaces

@inject IAccountDataService AccountDataService

<PageTitle>Resend email confirmation</PageTitle>

<div class="resend-wrapper">
    <div class="resend-card">

        <div class="resend-header">
            <div class="resend-logo-wrap">
                <img src="/images/logo.png" alt="Logo" class="resend-logo" />
            </div>

            <h1>Ponovno slanje potvrde</h1>
            <p>
                Unesite email adresu kako bismo vam ponovo poslali link za potvrdu naloga.
            </p>
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="resend-status-box @messageType">
                <div class="resend-status-icon">
                    @(messageType == "success" ? "✔" : "⚠")
                </div>
                <div class="resend-status-content">
                    <div class="resend-status-title">Obaveštenje</div>
                    <div class="resend-status-text">@message</div>
                </div>
            </div>
        }

        <EditForm Model="Input"
                  FormName="resend-email-confirmation"
                  OnValidSubmit="OnValidSubmitAsync"
                  method="post"
                  id="resendForm">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="resend-email">Email adresa</label>
                <InputText @bind-Value="Input.Email"
                           id="resend-email"
                           class="form-control modern-input"
                           aria-required="true"
                           placeholder="name@example.com" />
                <ValidationMessage For="() => Input.Email" class="validation-error" />
            </div>

            <button type="submit" class="resend-btn" id="resendButton">

                <span id="btnText">
                    Pošalji ponovo link za potvrdu
                </span>

                <span id="btnSpinner"
                      class="spinner-border spinner-border-sm ms-2"
                      role="status"
                      aria-hidden="true"
                      style="display:none">
                </span>
            </button>
            @* <button type="submit" class="resend-btn" disabled="@emailSent"> *@
            @*     Pošalji ponovo link za potvrdu *@
            @* </button> *@
        </EditForm>

        <div class="resend-footer">
            <a href="/" class="resend-secondary-link">← Povratak na početnu stranicu</a>
        </div>

    </div>
</div>

<script>
    
    document.addEventListener("DOMContentLoaded", function () {
    
        const form = document.getElementById("resendForm");
        const button = document.getElementById("resendButton");
        const spinner = document.getElementById("btnSpinner");
        const text = document.getElementById("btnText");
    
        if (!form) return;
    
        form.addEventListener("submit", function () {
    
            button.disabled = true;
            button.classList.add("submitting");
    
            if (spinner)
                spinner.style.display = "inline-block";
    
            if (text)
                text.textContent = "Slanje...";
    
        });
    
    });

</script>

@code {
    private string? message;
    private string messageType = "success";

    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();

    private async Task OnValidSubmitAsync()
    {
        try
        {
            await AccountDataService.ResendEmailConfirmationLink(Input.Email);
            message = "Poslali smo link za potvrdu email adrese. Molimo vas da proverite inbox, kao i spam folder ukoliko poruka nije odmah vidljiva.";
            messageType = "success";
        }
        catch (Exception e)
        {
            message = e.Message;
            messageType = "error";
        }
    }
    
    private sealed class InputModel
    {
        [Required(ErrorMessage = "Unesite email adresu")]
        [EmailAddress(ErrorMessage = "Unesite validnu email adresu")]
        public string Email { get; set; } = "";
    }
}