@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Diplomski.RatingHub.Application.Interfaces.Notifications
@using Diplomski.RatingHub.Infrastructure.Auth.Models
@using Diplomski.RatingHub.Web.CustomValidationAttributes
@using Diplomski.RatingHub.Web.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject IEmailNotificationService NotificationService
@inject ISmsNotificationService SmsNotificationService

<PageTitle>Forgot your password?</PageTitle>

<PageTitle>Forgot password</PageTitle>

<div class="resend-wrapper">
    <div class="resend-card">

        <div class="resend-header">
            <div class="resend-logo-wrap">
                <img src="/images/Logo-square.png" alt="Logo" class="resend-logo" />
            </div>

            <h1>Resetovanje sifre</h1>
            <p>
                Unesite email adresu ili broj telefona kako bismo vam poslali link ili kod za resetovanje sifre.
            </p>
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="resend-status-box @messageType">
                <div class="resend-status-icon">
                    @(messageType == "success" ? "✔" : "⚠")
                </div>
                <div class="resend-status-content">
                    <div class="resend-status-title">Obavestenje</div>
                    <div class="resend-status-text">@message</div>
                </div>
            </div>
        }

        <EditForm Model="Input"
                  FormName="forgot-password"
                  OnValidSubmit="OnValidSubmitAsync"
                  method="post"
                  id="forgotPasswordForm">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="forgot-verifier">Email ili telefon</label>
                <InputText @bind-Value="Input.Verifier"
                           id="forgot-verifier"
                           class="form-control modern-input"
                           aria-required="true"
                           placeholder="email@gmail.com ili 06xxxxxxxx" />
                <ValidationMessage For="() => Input.Verifier" class="validation-error" />
            </div>

            <button type="submit" class="resend-btn" id="resendButton">
                <span id="btnText">
                    Posalji link ili kod
                </span>

                <span id="btnSpinner"
                      class="spinner-border spinner-border-sm ms-2"
                      role="status"
                      aria-hidden="true"
                      style="display:none">
                </span>
            </button>
        </EditForm>

        <div class="resend-footer">
            <a href="/" class="resend-secondary-link">← Povratak na pocetnu stranicu</a>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const form = document.getElementById("forgotPasswordForm");
        const button = document.getElementById("resendButton");
        const spinner = document.getElementById("btnSpinner");
        const text = document.getElementById("btnText");

        if (!form) return;

        form.addEventListener("submit", function () {

            button.disabled = true;
            button.classList.add("submitting");

            if (spinner)
                spinner.style.display = "inline-block";

            if (text)
                text.textContent = "Slanje...";

        });

    });
</script>


@code {
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
    
    private string? message;
    private string messageType = "success";
    private bool shouldNavigateToResetPassword = false;
    
    private async Task OnValidSubmitAsync()
    {
        try
        {
            var user = await UserManager.FindByNameAsync(Input.Verifier);
            
            if (RegisterUserDto.IsEmail(Input.Verifier))
            {
                if (user is null || !(await UserManager.IsEmailConfirmedAsync(user)))
                {
                    message = "Nije moguce promeniti lozinku na ovom profilu";
                    messageType = "error";
                    
                    return;
                }
                
                
                var code = await UserManager.GeneratePasswordResetTokenAsync(user);
                code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
                var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                    NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
                    new Dictionary<string, object?> { ["code"] = code });

                await NotificationService.SendResetPasswordLinkAsync(Input.Verifier!, HtmlEncoder.Default.Encode(callbackUrl));
                
                message = "Poslali smo link za resetovanje sifre na vas eamil. " +
                          "Molimo vas da proverite inbox, kao i spam folder ukoliko poruka nije odmah vidljiva.";
                messageType = "success";
            }
            else
            {
                if (user is null || !(await UserManager.IsPhoneNumberConfirmedAsync(user)))
                {
                    message = "Nije moguce promeniti lozinku na ovom profilu";
                    messageType = "error";
                    
                    return;
                }
                
                var passwordResetToken = await UserManager.GenerateChangePhoneNumberTokenAsync(user, Input.Verifier);
                await SmsNotificationService.SendResetPasswordTokenWithEmail(passwordResetToken);

                shouldNavigateToResetPassword = true;
            }
        }
        catch (Exception)
        {
            message = "Doslo je do greske, molimo vas pokusajte ceo proces ponovo";
            messageType = "error";
            
            return;
        }

        if (shouldNavigateToResetPassword)
        {
            RedirectManager.RedirectTo(
                "Account/ResetPasswordByPhone",
                new() { ["phoneNumber"] = Input.Verifier });
        }
    }
    
    private sealed class InputModel
    {
        [Required(ErrorMessage = "Unesite email adresu ili broj telefona")]
        [EmailOrPhone]
        public string Verifier { get; set; } = "";
    }
    
}