@page "/Account/ResetPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Diplomski.RatingHub.Infrastructure.Auth.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities

@inject IdentityRedirectManager RedirectManager
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Reset password</PageTitle>

<div class="resend-wrapper">
    <div class="resend-card">

        <div class="resend-header">
            <div class="resend-logo-wrap">
                <img src="/images/Logo-square.png" alt="Logo" class="resend-logo" />
            </div>

            <h1>Postavljanje nove sifre</h1>
            <p>
                Unesite email adresu i novu sifru kako biste uspesno zavrsili resetovanje lozinke.
            </p>
        </div>

        <StatusMessage Type="danger" Message="@Message" />

        <EditForm Model="Input"
                  FormName="reset-password"
                  OnValidSubmit="OnValidSubmitAsync"
                  method="post"
                  id="resetPasswordForm">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" role="alert" />

            <input type="hidden" name="Input.Code" value="@Input.Code" />

            <div class="form-group">
                <label for="Input.Email">Email adresa</label>
                <InputText @bind-Value="Input.Email"
                           id="Input.Email"
                           class="form-control modern-input"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com" />
                <ValidationMessage For="() => Input.Email" class="validation-error" />
            </div>

            <div class="form-group">
                <label for="Input.Password">Nova sifra</label>
                <InputText type="password"
                           @bind-Value="Input.Password"
                           id="Input.Password"
                           class="form-control modern-input"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Unesite novu sifru" />
                <ValidationMessage For="() => Input.Password" class="validation-error" />
            </div>

            <div class="form-group">
                <label for="Input.ConfirmPassword">Potvrdite novu sifru</label>
                <InputText type="password"
                           @bind-Value="Input.ConfirmPassword"
                           id="Input.ConfirmPassword"
                           class="form-control modern-input"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Ponovo unesite sifru" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="validation-error" />
            </div>

            <button type="submit" class="resend-btn" id="resetButton">
                <span id="btnText">
                    Resetuj sifru
                </span>

                <span id="btnSpinner"
                      class="spinner-border spinner-border-sm ms-2"
                      role="status"
                      aria-hidden="true"
                      style="display:none">
                </span>
            </button>
        </EditForm>

        <div class="resend-footer">
            <a href="/" class="resend-secondary-link">← Povratak na pocetnu stranicu</a>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const form = document.getElementById("resetPasswordForm");
        const button = document.getElementById("resetButton");
        const spinner = document.getElementById("btnSpinner");
        const text = document.getElementById("btnText");

        if (!form) return;

        form.addEventListener("submit", function () {

            button.disabled = true;
            button.classList.add("submitting");

            if (spinner)
                spinner.style.display = "inline-block";

            if (text)
                text.textContent = "Resetovanje...";

        });

    });
</script>

@code {

    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery] private string? Code { get; set; }

    private string? Message;

    protected override void OnInitialized()
    {
        if (Code is null)
        {
            RedirectManager.RedirectTo("Account/InvalidPasswordReset");
        }

        Input.Code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
    }

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            Message = "Korisnik sa ovim mailom nije pronadjen";
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, Input.Code, Input.Password);
        if (result.Succeeded)
        {
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
        }
        else
        {
            Message = "Resetovanje sifre nije uspelo, molimo vas pokusajte ceo proces ponovo";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage="Unesite email")]
        [EmailAddress] public string Email { get; set; } = "";

        [Required(ErrorMessage = "Unesite sifru")]
        [RegularExpression(@"^(?=.*\d).{8,15}$",
            ErrorMessage = "Sifra se mora sastojati od 8-15 karaktera i mora sadrzati bar jedan broj")]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "Sifre se ne poklapaju")]
        public string ConfirmPassword { get; set; } = "";

        [Required] public string Code { get; set; } = "";
    }

}