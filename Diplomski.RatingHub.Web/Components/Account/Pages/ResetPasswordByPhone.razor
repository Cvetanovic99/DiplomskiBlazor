@page "/Account/ResetPasswordByPhone"
@using System.ComponentModel.DataAnnotations
@using Diplomski.RatingHub.Infrastructure.Auth.Models
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager

<PageTitle>Reset Password By Phone</PageTitle>

<div class="confirm-phone-wrapper">
    <div class="confirm-phone-card">
        <div class="confirm-phone-header">
            <div class="confirm-phone-logo-wrap">
                <img src="/images/Logo-square.png" alt="Logo" class="confirm-phone-logo" />
            </div>

            <h1>Resetovanje sifre</h1>
            <p>
                Unesite cetvorocifreni kod koji vam je poslat, a zatim novu sifru za vas nalog.
            </p>
        </div>

        @if (IsSuccess)
        {
            <div class="confirm-success-box">
                <div class="confirm-success-icon">✓</div>
                <div class="confirm-success-title">Sifra je uspesno promenjena.</div>
                <div class="confirm-success-text">
                    Vase resetovanje lozinke je uspesno zavrseno. Sada mozete da se prijavite sa novom sifrom.
                </div>
                <a href="/Account/Login" class="confirm-success-btn">Prijavi se</a>
            </div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="confirm-alert">@message</div>
            }

            <EditForm Model="@Input"
                      method="post"
                      OnValidSubmit="OnResetPassword"
                      FormName="reset-password-by-phone"
                      id="resetPasswordByPhoneForm">
                <DataAnnotationsValidator />

                <div class="otp-section">
                    <label class="otp-label">
                        Verifikacioni kod <span class="otp-required">*</span>
                    </label>

                    <div class="otp-container">
                        <InputText @bind-Value="Input.Digit1"
                                   id="digit1"
                                   class="form-control otp-input"
                                   maxlength="1" />

                        <InputText @bind-Value="Input.Digit2"
                                   id="digit2"
                                   class="form-control otp-input"
                                   maxlength="1" />

                        <InputText @bind-Value="Input.Digit3"
                                   id="digit3"
                                   class="form-control otp-input"
                                   maxlength="1" />

                        <InputText @bind-Value="Input.Digit4"
                                   id="digit4"
                                   class="form-control otp-input"
                                   maxlength="1" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="password">Nova sifra</label>
                    <InputText type="password"
                               @bind-Value="Input.Password"
                               id="password"
                               class="form-control modern-input"
                               autocomplete="new-password"
                               placeholder="Unesite novu sifru" />
                    <ValidationMessage For="() => Input.Password" class="validation-error" />
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Potvrdite novu sifru</label>
                    <InputText type="password"
                               @bind-Value="Input.ConfirmPassword"
                               id="confirmPassword"
                               class="form-control modern-input"
                               autocomplete="new-password"
                               placeholder="Ponovo unesite sifru" />
                    <ValidationMessage For="() => Input.ConfirmPassword" class="validation-error" />
                </div>

                <button type="submit" class="confirm-btn" id="confirmButton">
                    <span id="btnText">
                        Resetuj sifru
                    </span>

                    <span id="btnSpinner"
                          class="spinner-border spinner-border-sm ms-2"
                          role="status"
                          aria-hidden="true"
                          style="display:none">
                    </span>
                </button>
            </EditForm>
        }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const inputs = Array.from(document.querySelectorAll('.otp-input'));

        inputs.forEach((input, index) => {
            input.setAttribute('inputmode', 'numeric');
            input.setAttribute('pattern', '[0-9]*');
            input.setAttribute('autocomplete', 'one-time-code');

            input.addEventListener('input', function (e) {
                let value = e.target.value.replace(/\D/g, '');
                e.target.value = value.substring(0, 1);

                if (value && index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }
            });

            input.addEventListener('keydown', function (e) {
                if (e.key === 'Backspace' && !e.target.value && index > 0) {
                    inputs[index - 1].focus();
                }
            });

            input.addEventListener('paste', function (e) {
                e.preventDefault();

                const pasted = (e.clipboardData || window.clipboardData)
                    .getData('text')
                    .replace(/\D/g, '')
                    .substring(0, inputs.length);

                pasted.split('').forEach((char, i) => {
                    if (inputs[i]) {
                        inputs[i].value = char;
                    }
                });

                const nextIndex = Math.min(pasted.length, inputs.length - 1);
                if (inputs[nextIndex]) {
                    inputs[nextIndex].focus();
                }
            });
        });
    });

    document.addEventListener("DOMContentLoaded", function () {

        const form = document.getElementById("resetPasswordByPhoneForm");
        const button = document.getElementById("confirmButton");
        const spinner = document.getElementById("btnSpinner");
        const text = document.getElementById("btnText");

        if (!form) return;

        form.addEventListener("submit", function () {

            button.disabled = true;
            button.classList.add("submitting");

            if (spinner)
                spinner.style.display = "inline-block";

            if (text)
                text.textContent = "Resetovanje...";

        });

    });
</script>

@code
{
    [SupplyParameterFromQuery] private string? PhoneNumber { get; set; }
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
    private string? message;
    private bool IsSuccess { get; set; }
    
    public async Task OnResetPassword()
    {
        if (string.IsNullOrEmpty(PhoneNumber))
        {
            message = "Doslo je do greske, pokusajte ponovo";
            return;
        }
        
        if (!Input.IsComplete)
        {
            message = "Unesite sve 4 cifre.";
            return;
        }

        try
        {
            IsSuccess = true;
            return;
            var identityUser = await UserManager.FindByNameAsync(PhoneNumber);

            if (identityUser is null)
            {
                message = $"Korisnik sa brojem telefona: {PhoneNumber} nije pronadjen";
                return;
            }
                
            var result = await UserManager.ChangePhoneNumberAsync(identityUser!, identityUser!.PhoneNumber!, Input.Code);
            
            if (result.Succeeded)
            {
                await UserManager.RemovePasswordAsync(identityUser);
                await UserManager.AddPasswordAsync(identityUser, Input.Password);

                IsSuccess = true;
            }
            else
            {
                message = "Nije moguce resetovati sifru na ovom profilu, molimo vas pokusajte ceo proces ponovo";
            }
        }
        catch (Exception e)
        {
            message = "Doslo je do greske, molimo vas pokusajte ceo proces kasnije";
        }
        
    }
    
    public class InputModel
    {
        [Required(ErrorMessage = "Unesite sifru")]
        [RegularExpression(@"^(?=.*\d).{8,15}$",
            ErrorMessage = "Sifra se mora sastojati od 8-15 karaktera i mora sadrzati bar jedan broj")]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "Sifre se ne poklapaju")]
        public string ConfirmPassword { get; set; } = "";
        
        [Required]
        [RegularExpression(@"^\d$")]
        public string Digit1 { get; set; } = "";
    
        [Required]
        [RegularExpression(@"^\d$")]
        public string Digit2 { get; set; } = "";
    
        [Required]
        [RegularExpression(@"^\d$")]
        public string Digit3 { get; set; } = "";
    
        [Required]
        [RegularExpression(@"^\d$")]
        public string Digit4 { get; set; } = "";
    
        public string Code => $"{Digit1}{Digit2}{Digit3}{Digit4}";
    
        public bool IsComplete =>
            new[] { Digit1, Digit2, Digit3, Digit4 }
                .All(x => !string.IsNullOrWhiteSpace(x) && x.Length == 1 && char.IsDigit(x[0]));
    }
}
