@page "/Account/ResetPasswordConfirmation"
<PageTitle>Reset password confirmation</PageTitle>

<div class="confirmation-wrapper">
    <div class="confirmation-card">
        <div class="confirmation-header">
            <div class="confirmation-logo-wrap">
                <img src="/images/Logo-square.png" alt="Logo" class="confirmation-logo" />
            </div>

            <h1>Sifra je uspesno resetovana</h1>
            <p>
                Uspesno ste postavili novu sifru za vas nalog. Sada mozete da se prijavite koristeci nove pristupne podatke.
            </p>
        </div>

        <div class="confirmation-success-box">
            <div class="confirmation-success-icon">✓</div>
            <div class="confirmation-success-title">Resetovanje je uspesno zavrseno.</div>
            <div class="confirmation-success-text">
                Vasa lozinka je promenjena i nalog je spreman za prijavu.
            </div>

            <a href="/Account/Login" class="confirmation-success-btn">
                Idi na prijavu
            </a>
        </div>
    </div>
</div>