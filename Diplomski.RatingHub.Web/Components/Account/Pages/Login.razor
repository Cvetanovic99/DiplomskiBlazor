@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Diplomski.RatingHub.Infrastructure.Auth.Models
@using Diplomski.RatingHub.Web.CustomValidationAttributes
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Login</PageTitle>

<div class="auth-layout">

    <!-- LEFT SIDE -->
    <div class="auth-left">
        <div class="auth-left-overlay"></div>

        <div class="auth-left-content">
            <div class="auth-brand">
                <img src="/images/Logo-square.png" alt="RatingHub logo" class="auth-logo" />
                <span class="auth-brand-name">Kriterijum</span>
            </div>

            <div class="auth-left-text">
                <h1>Pronađite i ocenite najbolje usluge</h1>
                <p>
                    Platforma koja vam omogucava da na jednom mestu pregledate ocene,
                    komentare i preporuke korisnika za razlicite pruzaoce usluga.
                </p>
            </div>

            <div class="auth-left-points">
                <div class="auth-point">
                    <span class="auth-point-icon">✔</span>
                    <span>Provereni korisnici i pouzdane preporuke</span>
                </div>
                <div class="auth-point">
                    <span class="auth-point-icon">✔</span>
                    <span>Jednostavna pretraga i poredjenje usluga</span>
                </div>
                <div class="auth-point">
                    <span class="auth-point-icon">✔</span>
                    <span>Transparentne ocene i komentari</span>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT SIDE -->
    <div class="auth-right">

        <div class="auth-card">

            <div class="auth-header">
                <h2>Prijavite se</h2>
                <p>Unesite podatke za prijavu na svoj nalog.</p>
            </div>

            <StatusMessage Message="@Message" Type="danger" />

            <EditForm Model="UserModel"
                      asp-route-returnUrl="@ReturnUrl"
                      method="post"
                      OnValidSubmit="LoginUser"
                      FormName="login"
                      id="loginForm">

                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="login-verifier">Email ili telefon</label>
                    <InputText @bind-Value="UserModel.Verifier"
                               id="login-verifier"
                               class="form-control modern-input"
                               autocomplete="username"
                               placeholder="email@gmail.com ili 06xxxxxxxx" />
                    <ValidationMessage For="() => UserModel.Verifier" class="validation-error" />
                </div>

                <div class="form-group">
                    <label for="login-password">Sifra</label>
                    <InputText type="password"
                               @bind-Value="UserModel.Password"
                               id="login-password"
                               class="form-control modern-input"
                               autocomplete="current-password" />
                    <ValidationMessage For="() => UserModel.Password" class="validation-error" />
                </div>

                <button type="submit" class="auth-btn" id="auth-btn">
                    <span id="btnText">
                        Prijavi se
                    </span>

                    <span id="btnSpinner"
                          class="spinner-border spinner-border-sm ms-2"
                          role="status"
                          aria-hidden="true"
                          style="display:none">
                    </span>
                </button>
            </EditForm>

            <div class="auth-links">
                <a href="/Account/ForgotPassword" class="forgot-password-link">
                    Zaboravili ste lozinku?
                </a>
            </div>

            <div class="auth-footer">
                <a href="/" class="back-home-link">
                    ← Povratak na pocetnu stranicu
                </a>
            </div>

        </div>

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const form = document.getElementById("loginForm");
        const button = document.getElementById("auth-btn");
        const spinner = document.getElementById("btnSpinner");
        const text = document.getElementById("btnText");

        if (!form) return;

        form.addEventListener("submit", function () {

            button.disabled = true;
            button.classList.add("submitting");

            if (spinner)
                spinner.style.display = "inline-block";

            if (text)
                text.textContent = "Prijava u toku...";

        });

    });
</script>

@code {
    private string? Message;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private LoginUserModel UserModel { get; set; } = new();

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Clear the existing external cookie to ensure a clean login process
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser()
    {
        // This doesn't count login failures towards account lockout
        // To enable password failures to trigger account lockout, set lockoutOnFailure: true
        var result = await SignInManager.PasswordSignInAsync(UserModel.Verifier, UserModel.Password, false, lockoutOnFailure: false);
        if (result.Succeeded)
        {
            RedirectManager.RedirectTo("");
        }
        else
        {
            Message = "Prijavljivanje nije uspelo, proverite tacnost unetih podataka";
        }
    }

    public class LoginUserModel
    {
        [Required(ErrorMessage = "Unesite email ili broj telefona")]
        [EmailOrPhone]
        [Display(Name = "Email or Phone")]
        public string Verifier { get; set; } = "";

        [Required(ErrorMessage = "Unesite sifru")]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = "";
    }
}