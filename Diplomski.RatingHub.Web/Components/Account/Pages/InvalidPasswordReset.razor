@page "/Account/InvalidPasswordReset"

<PageTitle>Invalid password reset</PageTitle>

<div class="invalid-wrapper">
    <div class="invalid-card">
        <div class="invalid-header">
            <div class="invalid-logo-wrap">
                <img src="/images/Logo-square.png" alt="Logo" class="invalid-logo" />
            </div>

            <h1>Link za resetovanje nije ispravan</h1>
            <p>
                Link koji ste otvorili je neispravan.
                Molimo vas da ponovo pokrenete postupak za resetovanje sifre.
            </p>
        </div>

        <div class="invalid-alert-box">
            <div class="invalid-alert-icon">!</div>
            <div class="invalid-alert-title">Resetovanje nije moguce.</div>
            <div class="invalid-alert-text">
                Pokusajte ponovo tako sto cete zatraziti novi link za resetovanje lozinke.
            </div>

            <div class="invalid-actions">
                <a href="/Account/ForgotPassword" class="invalid-primary-btn">
                    Zatrazi novi link
                </a>

                <a href="/Account/Login" class="invalid-secondary-link">
                    Nazad na prijavu
                </a>
            </div>
        </div>
    </div>
</div>