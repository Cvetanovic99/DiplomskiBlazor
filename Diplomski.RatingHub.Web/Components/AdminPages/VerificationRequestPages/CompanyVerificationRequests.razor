@page "/companyVerificationRequests"
@using Diplomski.RatingHub.Application.UseCases.CompanyVerifications.Queries
@using Diplomski.RatingHub.Domain.Constants
@using Diplomski.RatingHub.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@inherits Diplomski.RatingHub.Web.Components.Shared.PortalComponentBase

@attribute [Authorize(Roles = Roles.Administrator)]

<div class="verification-page">

    <div class="verification-section">

        <div class="section-header">
            <h2>Zahtevi za verifikaciju</h2>
        </div>

        <div class="section-toolbar">

            <div class="verification-search-wrap">
                <RadzenTextBox @bind-Value="_search"
                               Placeholder="Pretraži po emailu ili kompaniji..."
                               class="verification-search-input"
                               @oninput="Search" />
            </div>

            <RadzenDropDown TValue="CompanyVerificationRequestStatus?"
                            @bind-Value="_status"
                            Data="@Enum.GetValues(typeof(CompanyVerificationRequestStatus))"
                            Placeholder="Status"
                            class="verification-dropdown"
                            Change="@OnFilterChanged"
                            AllowClear="true" >
                <Template>
                    @GetStatusOptions(context)
                </Template>
            </RadzenDropDown>

        </div>

        <div class="grid-responsive-wrap">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Visible="@(IsLoading)" />
            <RadzenDataGrid @ref="_grid"
                            Data="_data"
                            Count="_count"
                            Sortable="true"
                            LoadData="@LoadData"
                            TItem="CompanyVerificationRequestDto"
                            AllowPaging="true"
                            PageSize="20"
                            class="verification-grid">

                <Columns>

                    <RadzenDataGridColumn Sortable="false" Property="CompanyName" Title="Kompanija" />

                    <RadzenDataGridColumn Sortable="false" Property="ContactEmail" Title="Email" />

                    <RadzenDataGridColumn Sortable="false" Property="Status" Title="Status" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            @if (item.Status is CompanyVerificationRequestStatus.Pending)
                            {
                                <RadzenIcon Style="cursor: pointer" Icon="hourglass_top" IconStyle="IconStyle.Info" MouseEnter="@(args => ShowTooltip(args, "Na cekanju", TooltipPosition.Top))"/>
                            }
                            else if (item.Status is CompanyVerificationRequestStatus.Dismissed)
                            {
                                <RadzenIcon Style="cursor: pointer" Icon="x_circle" IconStyle="IconStyle.Danger" MouseEnter="@(args => ShowTooltip(args, "Odbijen", TooltipPosition.Top))"/>
                            }
                            else if (item.Status is CompanyVerificationRequestStatus.AcctionTaken)
                            {
                                <RadzenIcon Style="cursor: pointer" Icon="start" IconStyle="IconStyle.Primary" MouseEnter="@(args => ShowTooltip(args, "Obradjuje se", TooltipPosition.Top))"/>
                            }
                            else
                            {
                                <RadzenIcon Style="cursor: pointer" Icon="bookmark_check" IconStyle="IconStyle.Success" MouseEnter="@(args => ShowTooltip(args, "Prihvacen", TooltipPosition.Top))"/>
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="Created" Title="Datum" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            @item.Created.ToString("dd.MM.yyyy")
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Title="Akcije" TextAlign="TextAlign.Center">
                        <Template Context="item">

                            <div class="grid-actions">

                                <RadzenButton Icon="visibility"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Light"
                                              Click="@(() => OpenDetails(item))" />

                                <RadzenButton Icon="delete"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Click="@(() => Delete(item))" />

                            </div>

                        </Template>
                    </RadzenDataGridColumn>

                </Columns>

            </RadzenDataGrid>

        </div>

    </div>

</div>
    