@page "/Categories"

@using Diplomski.RatingHub.Application.UseCases.Categories.Queries
@using Diplomski.RatingHub.Domain.Constants
@using Diplomski.RatingHub.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@inherits Diplomski.RatingHub.Web.Components.Shared.PortalComponentBase

@attribute [Authorize(Roles = Roles.Administrator)]

<PageTitle>Kategorije</PageTitle>

<div class="categories-page">
    
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Visible="@(IsLoading)"/>
    
    <div class="categories-main-section">
        <div class="section-header">
            <h1>Kategorije</h1>
        </div>

        <div class="section-toolbar">
            <div class="categories-search-wrap">
                <RadzenTextBox @bind-Value="_filterValue"
                               Name="CategorySearch"
                               Placeholder="Pretrazite kategorije po nazivu..."
                               class="categories-search-input"
                               Style="width: 100%;"
                               @oninput="@Search"/>
            </div>

            <RadzenButton Text="Dodaj kategoriju"
                          Icon="add"
                          class="categories-add-btn"
                          Click="@OpenAddCategoryDialog"/>
        </div>

        <div class="grid-responsive-wrap">
            <RadzenDataGrid @ref="_categoriesGrid"
                            Data="_categories"
                            LoadData="@LoadCategories"
                            TItem="CategoryDto"
                            AllowPaging="true"
                            AllowSorting="true"
                            AllowFiltering="false"
                            PageSize="10"
                            Count="@_categoriesCount"
                            class="categories-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="CategoryDto" Property="Name" Title="Naziv" Width="25%"/>
                    <RadzenDataGridColumn TItem="CategoryDto" Title="Roditelj" Width="20%">
                        <Template Context="item">
                            @if (item.ParentName is not null)
                            {
                                <span class="ellipsis-text">@item.ParentName</span>
                            }
                            else
                            {
                                <RadzenIcon Style="cursor: pointer"
                                            MouseEnter="@(args => ShowTooltip(args, "Top kategorija", TooltipPosition.Top))"
                                            Icon="cancel"
                                            IconStyle="IconStyle.Danger"/>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CategoryDto" Property="CompaniesCount" Title="Broj kompanija" Width="18%"/>

                    <RadzenDataGridColumn TItem="CategoryDto" Title="Kljucne reci" Width="27%" Sortable="false">
                        <Template Context="item">
                            <span class="ellipsis-text">
                                @(string.Join(",", item.Keywords.Select(k => k.Keyword)))
                            </span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="CategoryDto" Title="Akcije" Width="10%" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <div class="grid-actions">
                                <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                              Click="@(args => OpenEditCategoryDialog(item))"/>
                                <RadzenButton Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                              MouseEnter="@(args => ShowTooltip(args, "Dodaj podkategoriju", TooltipPosition.Top))"
                                              Click="@(args => OpenAddSubcategoryDialog(item))"/>
                                <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                              Click="@(args => DeleteCategory(item))"/>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>

    <div class="section-divider"></div>

    <div class="categories-secondary-section">
        <div class="section-header">
            <h2>Predlozi korisnika za nove kategorije</h2>
        </div>

        <div class="grid-responsive-wrap">
            <RadzenDataGrid @ref="_categorySuggestionsGrid"
                            LoadData="@LoadCategorySuggestions"
                            Data="@_categorySuggestions"
                            TItem="NewCategorySuggestionDto"
                            AllowPaging="true"
                            AllowSorting="true"
                            AllowFiltering="true"
                            FilterMode="FilterMode.Simple"
                            PageSize="10"
                            Count="@_categoriySuggestionsCount"
                            class="categories-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="NewCategorySuggestionDto" Property="Name" Title="Naziv" Width="15%"/>
                    <RadzenDataGridColumn TItem="NewCategorySuggestionDto" Property="SuggestedParent" Title="Preporucen roditelj" Width="15%">
                        <Template Context="item">
                            @if (string.IsNullOrEmpty(item.SuggestedParent))
                            {
                                <RadzenIcon Style="cursor: pointer"
                                            MouseEnter="@(args => ShowTooltip(args, "Nema preporuke", TooltipPosition.Top))"
                                            Icon="cancel"
                                            IconStyle="IconStyle.Danger"/>
                            }
                            else
                            {
                                <span class="ellipsis-text">@item.SuggestedParent</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="NewCategorySuggestionDto" Property="Text" Title="Opis" Width="40%">
                        <Template Context="item">
                            <span class="ellipsis-text" title="@item.Text">
                                @item.Text
                            </span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="NewCategorySuggestionDto" Property="Status" Title="Status" 
                                          Width="10%" TextAlign="TextAlign.Center"
                                          FilterOperator="FilterOperator.Equals" Filterable="true">
                        <FilterTemplate>
                            <RadzenDropDown @bind-Value="_selectedSuggestionStatus" Style="width:100%;" Placeholder="Izaberi..."
                                            Data="@NewCategorySuggestionsFilterValues.CategorySuggestionStatuses"
                                            Change="@OnSuggestionStatusFilterChanged"
                                            AllowClear="true">
                                <Template Context="statusContext">
                                    @GetStatusOptions(statusContext)
                                </Template>
                            </RadzenDropDown>
                        </FilterTemplate>
                        <Template Context="item">
                            @if (item.Status is NewCategorySuggestionStatus.Pending)
                            {
                                <RadzenIcon Style="cursor: pointer" Icon="hourglass_top" IconStyle="IconStyle.Info" MouseEnter="@(args => ShowTooltip(args, "Na cekanju", TooltipPosition.Top))"/>
                            }
                            else if (item.Status is NewCategorySuggestionStatus.Dismissed)
                            {
                                <RadzenIcon Style="cursor: pointer" Icon="x_circle" IconStyle="IconStyle.Danger" MouseEnter="@(args => ShowTooltip(args, "Ignorisan", TooltipPosition.Top))"/>
                            }
                            else
                            {
                                <RadzenIcon Style="cursor: pointer" Icon="bookmark_check" IconStyle="IconStyle.Success" MouseEnter="@(args => ShowTooltip(args, "Prihvacen", TooltipPosition.Top))"/>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="NewCategorySuggestionDto" Property="Created" Title="Kreirano" Width="10%">
                        <Template Context="item">
                            @item.Created.ToString("dd.MM.yyyy")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="NewCategorySuggestionDto" Title="Akcije" Width="10%" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <div class="grid-actions">
                                <RadzenButton Icon="edit"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Light"
                                              Click="@(args => OpenEditSuggestionDialog(item))"/>
                                <RadzenButton Icon="delete"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Click="@(args => DeleteSuggestion(item))"/>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>

</div>