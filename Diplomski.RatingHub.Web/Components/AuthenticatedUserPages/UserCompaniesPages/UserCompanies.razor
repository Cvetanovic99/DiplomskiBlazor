@page "/user/companies"
@using Diplomski.RatingHub.Domain.Constants
@using Diplomski.RatingHub.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@using Diplomski.RatingHub.Web.Components.UserPages.CompanyDetailsPages
@inherits Diplomski.RatingHub.Web.Components.Shared.PortalComponentBase

@attribute [Authorize(Roles = Roles.RegularUser)]

<div class="company-container">
    <RadzenRow Style="border-bottom: 1px solid #d3d3d5; margin-bottom: 17px; padding: 5px;">
        <RadzenColumn Size="12" SizeMD="8">
            <h1 style="margin: 0;">Vaše kompanije</h1>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4" Style="display: flex; flex-direction: row; gap:5px; align-items: center;">
            <RadzenButton Text="Dodaj kompaniju" Icon="domain_add" Click="OnCreateCompanyClicked" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"/>
            <RadzenButton Text="Preuzmi kompaniju" Icon="output_circle" Click="OnClaimCompanyClicked" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"/>
        </RadzenColumn>
    </RadzenRow>
    @if (Company != null)
    {
        <!-- BREADCRUMB -->
        <div class="breadcrumb">
            @for (int i = 0; i < _breadcrumbs.Count; i++)
            {
                var localIndex = i;
                if (i != _breadcrumbs.Count - 1)
                {
                    <span class="parent-breadcrumb">@_breadcrumbs[i].Name</span>
                    <span style="font-weight: 700; color: #3f3939;"> > </span>
                }
                else
                {
                    <span class="current-breadcrumb">@_breadcrumbs[i].Name</span>
                }
            }
        </div>

        <div class="layout">

            <!-- LEFT -->
            <div class="main">

                @if (string.IsNullOrEmpty(Company.Name))
                {
                    <RadzenText TextStyle="TextStyle.H1" Style="width: 100%">
                        <RadzenSkeleton Animation="SkeletonAnimation.Wave" Style="width: 100%"/>
                    </RadzenText>
                }
                else
                {
                    <div class="header">

                        <!-- IMAGE -->
                        <div class="image">
                            <img src="@GetProfileImage()"/>
                        </div>

                        <div class="info">

                            <!-- NAME + ACTIONS -->
                            <div class="top-row">

                                <h1 class="company-title">
                                    @Company.Name
                                </h1>
                                <div class="actions">
                                    @if (!Company.IsSponsored)
                                    {
                                        <div class="report-action-icon-wrapper">
                                            <RadzenIcon Icon="editor_choice" IconStyle="IconStyle.Light" class="report-action-icon" @onclick="SponsorCompanyClicked"
                                                        MouseEnter="@(args => ShowTooltip(args, "Sponzorisi kompaniju", TooltipPosition.Top))"/>
                                        </div>
                                    }
                                    
                                    @if (!Company.IsVerified && (Company.VerificationRequest == null || Company.VerificationRequest.Status == CompanyVerificationRequestStatus.Dismissed))
                                    {
                                        <div class="report-action-icon-wrapper">
                                            <RadzenIcon Icon="verified" IconStyle="IconStyle.Light" class="report-action-icon" @onclick="VerifyCompanyClicked"
                                                        MouseEnter="@(args => ShowTooltip(args, "Verifikuj kompaniju", TooltipPosition.Top))"/>
                                        </div>
                                    }

                                    <RadzenProfileMenu class="more-vert" Click="@OnCompanyActionsClicked" MouseEnter="@(args => ShowTooltip(args, "Ažuriraj kompaniju", TooltipPosition.Top))">
                                        <Template>
                                            <RadzenIcon Icon="edit" IconStyle="IconStyle.Light" IconColor="black"/>
                                        </Template>
                                        <ChildContent>
                                            <RadzenProfileMenuItem Text="Edituj" Icon="edit" Value="@_edit"/>
                                            <RadzenProfileMenuItem Text="Obrisi" Icon="delete" Value="@_delete"/>
                                        </ChildContent>
                                    </RadzenProfileMenu>

                                </div>

                            </div>

                            <!-- RATING -->
                            <div class="company-rating">
                                <div class="provider-rating-box">
                                    <div class="provider-rating-stars" style="@GetStarsFillStyle(Company.OverallAverageGrade)">
                                        <div class="provider-rating-stars-base">★★★★★</div>
                                        <div class="provider-rating-stars-fill">★★★★★</div>
                                    </div>
                                </div>

                                <span class="rating-value">@Company.OverallAverageGrade.ToString("0.0")</span>
                                <span class="reviews">(@Company.ReviewsCount ocena)</span>
                            </div>

                            <!-- STATUS -->
                            <div class="company-status">

                                @if (Company.IsVerified)
                                {
                                    <div class="status-item verified">
                                        <RadzenIcon Icon="verified" MouseEnter="@(args => ShowTooltip(args, "Kompaniju ste verifikovali na nasoj platformi", TooltipPosition.Top))"/>
                                        <span class="status-item-text">Verifikovana</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="status-item verified-off">
                                        <RadzenIcon Icon="verified_off" MouseEnter="@(args => ShowTooltip(args, "Kompaniju niste verifikovali na nasoj platformi", TooltipPosition.Top))"/>
                                        <span class="status-item-text">Nije verifikovana</span>
                                    </div>
                                }

                            </div>

                            <!-- PIB -->
                            @if (!string.IsNullOrEmpty(Company.CompanyPib))
                            {
                                <div class="main-data-row ">
                                    <label>
                                        <span style="font-weight: 600; color: #393838">PIB:</span>
                                        <span class="main-data-text">@Company.CompanyPib </span>
                                    </label>
                                </div>
                            }

                            <div class="main-data-row">
                                @if (Company.IsEmailVerifier)
                                {
                                    <RadzenIcon Icon="mail"/>
                                }
                                else
                                {
                                    <RadzenIcon Icon="call"/>
                                }

                                <span class="main-data-text">@Company.Verifier</span>
                            </div>

                            <!-- ADDRESS -->
                            <div class="main-data-row">
                                <RadzenIcon Icon="location_on"/>
                                <span class="main-data-text">@FullAddress</span>
                            </div>

                            <!-- BUTTONS -->
                            <div class="buttons">
                                @if (!string.IsNullOrEmpty(Company.PublicPageUrl))
                                {
                                    <a class="secondary"
                                       href="@Company.PublicPageUrl"
                                       target="_blank">
                                        Poseti sajt
                                        <RadzenIcon Icon="open_in_new"/>
                                    </a>
                                }

                            </div>

                        </div>
                    </div>
                }

                <div class="divider"></div>

                @if (Company.Images != null && Company.Images.Any())
                {
                    <div class="company-gallery">

                        @{
                            var images = Company.Images;
                            var visibleCount = 5;
                            var visibleImages = images.Take(visibleCount).ToList();
                            var remaining = images.Count - visibleImages.Count;
                        }

                        @for (int i = 0; i < visibleImages.Count; i++)
                        {
                            var localIndex = i;
                            <div class="gallery-item"
                                 @onclick="() => OpenGallery(localIndex)">
                                <img src="@visibleImages[i]"/>
                            </div>
                        }

                        @if (remaining > 0)
                        {
                            <div class="gallery-item gallery-more"
                                 @onclick="() => OpenGallery(visibleCount)">
                                <span>+@remaining</span>
                            </div>
                        }

                    </div>
                }

                @if (Company.Id != 0)
                {
                    <div class="verification-card verified">

                        <div class="verification-icon">
                            <RadzenIcon Icon="percent"/>
                        </div>

                        <div class="verification-content">

                            <div class="verification-title">
                                Tačnost vaših podataka
                            </div>

                            <div class="verification-text">
                                <text>
                                    Udeo korisničkih ocena koje potvrđuju ili negiraju ispravnost navedenih podataka o vašoj kompaniji
                                </text>

                            </div>

                            <div class="verification-stats">

                                <div class="stat">
                                    <span class="label">Tačni podaci</span>
                                    <div class="bar">
                                        <div class="fill correct" style="width: @_trueDataPercentage.ToString("0.0")%"></div>
                                    </div>
                                    <span class="value">@_trueDataPercentage.ToString("0")%</span>
                                </div>

                                <div class="stat">
                                    <span class="label">Netačni podaci</span>
                                    <div class="bar">
                                        <div class="fill incorrect" style="width: @_falseDataPercentage.ToString("0.0")%"></div>
                                    </div>
                                    <span class="value">@_falseDataPercentage.ToString("0")%</span>
                                </div>

                            </div>

                        </div>

                    </div>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.H1" Style="width: 100%">
                        <RadzenSkeleton Animation="SkeletonAnimation.Wave" Style="width: 100%"/>
                    </RadzenText>
                }

                @if (!string.IsNullOrWhiteSpace(Company.Description))
                {
                    <div class="company-description">

                        <div class="desc-header">
                            <RadzenIcon Icon="description" class="desc-icon"/>
                            <span style="font-weight: 300; font-size: 25px">Opis kompanije</span>
                        </div>

                        <div class="desc-text">

                            @if (!_isDescriptionExpanded)
                            {
                                @_shortDescription

                                @if (_hasMoreDescription)
                                {
                                    <span>... </span>
                                    <span class="desc-toggle-inline" @onclick="ToggleDescription">
                                        Vidi još
                                    </span>
                                }
                            }
                            else
                            {
                                @Company.Description

                                @if (_hasMoreDescription)
                                {
                                    <span class="desc-toggle-inline" @onclick="ToggleDescription">
                                        Prikaži manje
                                    </span>
                                }
                            }

                        </div>

                    </div>
                }
                
                @if (Company.VerificationRequest != null)
                {
                    <div class="verification-card request">

                        <div class="request-icon">
                            <RadzenIcon Icon="order_approve"/>
                        </div>

                        <div class="verification-content">
                            <div class="request-title-and-actions">
                                <div class="verification-title">
                                    Zahtev za verifikaciju
                                </div>
                                
                                <div class="report-action-icon-wrapper" style="background: transparent">
                                    <RadzenIcon Icon="delete" Style="background: transparent;" IconStyle="IconStyle.Light" class="report-action-icon" @onclick="DeleteVerificationRequestClicked"
                                                MouseEnter="@(args => ShowTooltip(args, "Izbrisi zahtev", TooltipPosition.Top))"/>
                                </div>
                            </div>

                            <div class="verification-text">
                                <text>
                                    @(string.IsNullOrEmpty(Company.VerificationRequest.Description) ? "Nema opisa" : Company.VerificationRequest.Description)
                                </text>

                            </div>

                            <div class="verification-stats">

                                <div class="request-data">
                                    <span class="label">Kontakt email: </span>
                                    <div style="font-size: 14px; color: #4d4b4b; font-weight: bold;">
                                        @Company.VerificationRequest.ContactEmail
                                    </div>
                                </div>

                                <div class="request-data">
                                    <span class="label">Status: </span>
                                    <div style="font-size: 14px; color: #4d4b4b; font-weight: bold;">
                                        @if (Company.VerificationRequest.Status == CompanyVerificationRequestStatus.Dismissed)
                                        {
                                            <RadzenIcon Style="cursor: pointer" Icon="x_circle" IconStyle="IconStyle.Danger" MouseEnter="@(args => ShowTooltip(args, "Odbijen", TooltipPosition.Top))"/>
                                        }else if (Company.VerificationRequest.Status == CompanyVerificationRequestStatus.Pending)
                                        {
                                            <RadzenIcon Style="cursor: pointer" Icon="hourglass_top" IconStyle="IconStyle.Info" MouseEnter="@(args => ShowTooltip(args, "Ceka na obradu", TooltipPosition.Top))"/>
                                        } else if (Company.VerificationRequest.Status == CompanyVerificationRequestStatus.AcctionTaken)
                                        {
                                            <RadzenIcon Style="cursor: pointer" Icon="start" IconStyle="IconStyle.Primary" MouseEnter="@(args => ShowTooltip(args, "Obradjuje se", TooltipPosition.Top))"/>
                                        }else
                                        {
                                            <RadzenIcon Style="cursor: pointer" Icon="bookmark_check" IconStyle="IconStyle.Success" MouseEnter="@(args => ShowTooltip(args, "Prihvacen", TooltipPosition.Top))"/>
                                        }
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>
                }
                @if (Company.IsSponsored)
                {
                    <div class="verification-card request">

                        <div class="request-icon">
                            <RadzenIcon Icon="editor_choice"/>
                        </div>

                        <div class="verification-content">
                            <div class="request-title-and-actions">
                                <div class="verification-title">
                                    Sponzorisanje kompanije
                                </div>
                                
                                <div class="report-action-icon-wrapper" style="background: transparent">
                                    <RadzenIcon Icon="delete" Style="background: transparent;" IconStyle="IconStyle.Light" class="report-action-icon" @onclick="RemoveCompanyFromSponsoredClicked"
                                                MouseEnter="@(args => ShowTooltip(args, "Skloni sponzorstvo", TooltipPosition.Top))"/>
                                </div>
                            </div>

                            <div class="verification-text">
                                <text>
                                    Vaša kompanija je trenutno sponzorisana, što znači da je dodatno istaknuta korisnicima. Ako želite da prestanete sa sponzorstvom, kliknite na dugme za brisanje.
                                </text>

                            </div>

                            <div class="verification-stats">

                                <div class="request-data">
                                    <span class="label">Sponzorisana do datuma: </span>
                                    <div style="font-size: 14px; color: #4d4b4b; font-weight: bold;">
                                        @GetSponsoredDate()
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                }
            </div>

            <!-- RIGHT -->
            <div class="sidebar">
                @if (Company.Id != 0)
                {
                    <CompanyDetailsAdditionalData CompanyId="Company.Id" @key="Company.Id"/>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.H1" Style="width: 100%">
                        <RadzenSkeleton Animation="SkeletonAnimation.Wave" Style="width: 100%"/>
                    </RadzenText>
                }
            </div>

            <RadzenPager Count="@_companiesTotalCount"
                         PageSize="@_pageSize"
                         @bind-CurrentPage="_currentPage"
                         PageChanged="@OnPageChanged"
                         ShowPagingSummary="true"
                         PagingSummaryFormat="@pagingSummaryFormat"
                         Style="padding-top: 20px"/>

        </div>

        <div class="divider"></div>
    }
    else
    {
        <div class="no-companies-container">

            <div class="no-companies-card">

                <div class="no-companies-icon">
                    <RadzenIcon Icon="sentiment_dissatisfied"/>
                </div>

                <h3> Nemate kreiranih kompanija</h3>

                <p>
                    Klikom na "Dodaj kompaniju" na vrhu stranice mozete je kreirati.
                </p>

            </div>

        </div>
    }
</div>

@if (Company != null && Company.Id != 0)
{
    <UserCompanyReviews CompanyId="Company.Id" @key="Company.Id"/>
}
