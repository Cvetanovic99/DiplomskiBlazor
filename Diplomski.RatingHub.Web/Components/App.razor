@using System.Security.Claims
@using Diplomski.RatingHub.Application.Interfaces.Services

@inject ICurrentUserService CurrentUserService

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["Diplomski.RatingHub.Web.styles.css"]"/>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <ImportMap/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet @rendermode="@PageRenderMode" />
    <RadzenTheme Theme="material" />
</head>

<body>
<Routes @rendermode="@PageRenderMode" /> 
<script src="_framework/blazor.web.js"></script>
<script src="lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="jsscripts/CreateCompanyDisplayMap.js"></script>
<script src="jsscripts/CompaniesMapDesctopView.js"></script>
<script src="jsscripts/CompaniesMapMobileView.js"></script>
<script src="jsscripts/CompanyDetailsMap.js"></script>
<script src="jsscripts/LocalStorageFunctions.js"></script>

<script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>
</body>

</html>

@code
{
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode
        => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
    

    //Store Current user data
    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContext;
        if (httpContext == null) return;

        var user = httpContext.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
            await CurrentUserService.SetAuthenticatedUser(userId);
        }
        else
        {
            // Anonimni kolačić
            var request = httpContext.Request;
            var response = httpContext.Response;
            string anonymousId = request.Cookies["AnonymousId"];

            if (string.IsNullOrEmpty(anonymousId))
            {
                anonymousId = Guid.NewGuid().ToString();
                response.Cookies.Append("AnonymousId", anonymousId, new CookieOptions
                {
                    Expires = DateTimeOffset.UtcNow.AddYears(1),
                    HttpOnly = true,      // Ne može JS da čita – bezbednije
                    Secure = true,
                    SameSite = SameSiteMode.Strict
                });
            }

            CurrentUserService.SetAnonymousUser(anonymousId);
        }
    }
}